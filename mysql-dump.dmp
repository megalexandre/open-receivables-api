INSERT INTO `category` VALUES (1,'Sócio Contribuinte Temporário','São aqueles que contribuem, regularmente com o pagamento \nda taxa  do sistema de abastecimento de agua de lages, \ndesde que comprovem, com documento, que soa propietarios \nde imovel em que residem ou inquilinios que tenham contrato de alguel\n, devidamenteo autenticados em cartorio.',1,3,30.00,0.00,0),(2,'Sócio Contribuinte efetivo','São aqueles que estiverem devidamente casdastrados\nna acal e que estejam cumprindo seus deveres na forma\ndesse estatuto.',2,2,27.00,3.00,0),(3,'Sócio Fundador','',30,1,30.00,0.00,0),(4,'Sócio Contribuinte Efetivo (Hidrômetro) A','Categoria dos Hidrometros',5,2,27.00,3.00,1),(5,'Sócio Contribuinte Temporario (Hidrômetro)','Hidrometros ativo paga taxa de R$ 20,00',6,3,30.00,0.00,1),(6,'Hidrômetro Associado Desligado','Hidrometros Associado Desligado',7,3,24.00,0.00,1),(7,' Contribuinte [INATIVO]','fazenda umbaumba',8,3,30.00,3.00,0),(8,'(Contribuinte Efetivo (dupla residencia))...','Socios que possuirem dupla residencia',10,2,54.00,6.00,0),(10,'Dupla Residencia Socio Temporário','',11,3,60.00,0.00,0),(11,'Socio Não Residente','Contribuiente efetivo, São aqueles que estiverem devidamente cadastrado na Acal e que estejam cumprindo os seus deveres na forma deste Estatuto.',12,2,9.00,0.00,0),(13,'Contribuinte efetivo ','',9,2,30.00,3.00,0),(14,'Restaurante','',16,3,48.80,0.00,0),(15,'(Sócio Contribuinte efetivo)','São aqueles que estiverem devidamente cadastrado na ACAL e que estejam cumprindo os seus deveres na forma deste estatuto.',12,2,9.00,0.00,0),(16,'((CONTRIBUINTE EFETIVO)','',9,2,30.00,3.00,0),(17,'FAZENDA','',22,3,24.00,0.00,0),(18,'Prefeitura','Categoria para cadastro dos predios da prefeitura',23,3,97.60,0.00,0),(19,'Sócio Contribuinte Efetivo (hidrometro) B','fazenda de socio contribuinte efetivo.',13,2,43.92,4.88,1),(20,'Hidrômetro temporario ','',1,3,30.00,0.00,1),(21,'Hidrômetro taxa minina 12','',24,3,30.00,0.00,1),(22,'sitio ...','',25,3,48.80,0.00,0),(23